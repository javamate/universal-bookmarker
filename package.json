{
  "name": "universal-bookmarker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite build --mode extension --watch",
    "build": "tsc -b && vite build",
    "build:extension": "vite build --mode extension",
    "build:all": "npm run build && npm run build:extension",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preact/signals": "^1.2.3",
    "algoliasearch": "^4.24.0",
    "cheerio": "^1.0.0",
    "crypto-js": "^4.2.0",
    "instantsearch.js": "^4.73.3",
    "jsdom": "^25.0.1",
    "preact": "^10.27.2",
    "preact-router": "^4.1.2"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@types/chrome": "^0.0.268",
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-web-extension": "^4.1.1",
    "web-ext": "^9.2.0"
  }
}
